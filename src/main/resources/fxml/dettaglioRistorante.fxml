<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="theknife.client.controller.DettaglioRistoranteController"
            fitToWidth="true" styleClass="pagina">
    <VBox spacing="10">
        <padding>
            <Insets top="20" right="30" bottom="30" left="30"/>
        </padding>

        <Label fx:id="etichettaNome" styleClass="titolo"/>
        <Label fx:id="etichettaErrore" styleClass="errore"/>

        <VBox spacing="4" styleClass="riquadro">
            <Label fx:id="etichettaIndirizzo"/>
            <Label fx:id="etichettaLuogo"/>
            <Label fx:id="etichettaCucina"/>
            <Label fx:id="etichettaPrezzo"/>
            <Label fx:id="etichettaServizi"/>
            <Label fx:id="etichettaValutazione"/>
        </VBox>

        <VBox fx:id="sezioneCliente" spacing="8" styleClass="riquadro">
            <Button fx:id="bottonePreferito" onAction="#alternaPreferito"/>
            <Separator/>
            <VBox fx:id="contenitoreRecensionePropria" spacing="6"/>
        </VBox>

        <Separator/>
        <Label text="Recensioni" styleClass="sottotitolo"/>
        <VBox fx:id="contenitoreRecensioni" spacing="10"/>
    </VBox>
</ScrollPane>
