<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="theknife.client.controller.AggiungiRistoranteController"
            fitToWidth="true" styleClass="pagina">
    <VBox alignment="CENTER" spacing="10">
        <padding>
            <Insets top="20" right="60" bottom="40" left="60"/>
        </padding>

        <Label text="Aggiungi un nuovo ristorante" styleClass="titolo"/>

        <VBox spacing="8" maxWidth="420" styleClass="riquadro">
            <Label text="Nome"/>
            <TextField fx:id="campoNome"/>
            <Label text="Nazione"/>
            <ComboBox fx:id="campoNazione" maxWidth="420" promptText="Scegli una nazione"/>
            <Label text="Citta'"/>
            <ComboBox fx:id="campoCitta" maxWidth="420" editable="true" promptText="Scegli o scrivi una citta'"/>
            <Label text="Indirizzo"/>
            <TextField fx:id="campoIndirizzo"/>
            <Label text="Fascia di prezzo media (EUR)"/>
            <TextField fx:id="campoFasciaPrezzo"/>
            <Label text="Tipi di cucina (separati da virgola)"/>
            <TextField fx:id="campoTipiCucina" promptText="Es. Italiana, Pizza"/>
            <HBox spacing="20">
                <CheckBox fx:id="checkDelivery" text="Servizio di delivery"/>
                <CheckBox fx:id="checkPrenotazione" text="Prenotazione online"/>
            </HBox>

            <Button text="Crea ristorante" onAction="#creaRistorante" styleClass="bottone-primario"/>
            <Label fx:id="etichettaErrore" styleClass="errore" wrapText="true"/>
        </VBox>
    </VBox>
</ScrollPane>
