<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="theknife.client.controller.MieRecensioniController"
            fitToWidth="true" styleClass="pagina">
    <VBox spacing="10">
        <padding>
            <Insets top="20" right="30" bottom="30" left="30"/>
        </padding>
        <Label text="Le mie recensioni" styleClass="titolo"/>
        <Label fx:id="etichettaErrore" styleClass="errore"/>
        <VBox fx:id="contenitore" spacing="12"/>
    </VBox>
</ScrollPane>
